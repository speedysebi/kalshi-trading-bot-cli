# Free local setup: real Kalshi account + local Ollama model, no Octagon.
#
# Copy this file to ~/.kalshi-bot/.env (NOT into this repo) and fill in the
# placeholders. Never commit real keys: .env and *.pem are git-ignored.
#
# Also create ~/.kalshi-bot/settings.json so the TUI picks Ollama too:
#   { "provider": "ollama", "modelId": "ollama:qwen3.8:27b" }
#
# Without Octagon, analyze / search edge / backtest / basket / clusters don't
# work. search (local cache), watch, portfolio, mandate and paper trading do.

# false = real Kalshi account (paper trading needs live prices)
# true  = Kalshi demo exchange (needs separate keys from demo.kalshi.co)
KALSHI_USE_DEMO=false

# ── Kalshi ────────────────────────────────────────────────────────────
# Key ID from kalshi.com → Account/Settings → API Keys
KALSHI_API_KEY=your-kalshi-key-id
# Full path to the private key file you downloaded when creating the key,
# kept outside this repo and outside OneDrive/Dropbox
KALSHI_PRIVATE_KEY_FILE=your-pem-file-path

# ── AI provider: local Ollama (no key needed) ────────────────────────
# Keep Ollama running. Use any model from `ollama list`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=ollama:qwen3.8:27b

# ── Octagon (paid; left out on purpose) ──────────────────────────────
# Leave commented out: any non-empty value, even a placeholder, makes the
# bot route search through Octagon and fail.
# OCTAGON_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Free-tier web search for the chat assistant
# TAVILY_API_KEY=
